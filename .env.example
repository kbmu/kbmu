# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# The bot loads this file automatically on startup (via python-dotenv).

# --- Coinbase API credentials (required) ---
# COINBASE_API_KEY is the key id, e.g. organizations/.../apiKeys/...
# COINBASE_API_SECRET is the EC private key. Put it on ONE line wrapped in
# double quotes, with the line breaks written as \n, for example:
#   COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcC...\n-----END EC PRIVATE KEY-----\n"
COINBASE_API_KEY=your-coinbase-api-key
COINBASE_API_SECRET="your-coinbase-api-secret"

# --- Trading configuration ---
TRADING_SYMBOL=XRP/USD
LOOP_INTERVAL_SECONDS=60

# Safety switch. Leave as "true" to simulate trades without placing real orders.
# Set to "false" ONLY when you intend to trade real funds.
DRY_RUN=true

# Place server-side bracket orders (take-profit + stop-loss, OCO) at entry so
# the exchange enforces exits even if the bot is offline. UNVERIFIED against
# live Coinbase — leave "false" until you have tested it with minimal funds.
USE_EXCHANGE_PROTECTIVE_ORDERS=false

# Where the open position is persisted so exits survive a restart.
POSITION_STATE_FILE=position_state.json

# --- Email notifications (optional) ---
# Use a Gmail App Password, NOT your account password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
NOTIFY_EMAIL=alerts-recipient@example.com
